---
import "../styles/site.css";
import { IDENTITY } from "../../data/arush.mjs";
const { title, description, wide = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · Rabbi Shalom Arush` : "Rabbi Shalom Arush — The Garden of Emuna in English";
const desc = description || IDENTITY.intro;
// Haesh Sheli — a real fire flame (owner: no olive-leaf; the famous "my fire" symbol).
// THE REAL EMBLEM — the האש שלי flame, from the movement's own embroidered patch
// (owner supplied it 2026-07-26: "the logo thats wrong"). What stood here before was a
// generic orange flame I drew myself. Never invent a mosad's emblem — use theirs.
const mark = "/img/haesh-logo.png";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={desc} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta name="theme-color" content="#0b1220" />
<meta name="google-site-verification" content="QWT6Jxpk4s_lNAFruUu1YpS_8wBfJrPhygfLCvzl7Q0" />
<meta name="keywords" content="Rabbi Shalom Arush, Rav Shalom Arush, Shalom Arush, HaRav Shalom Arush, הרב שלום ארוש, שלום ארוש, Garden of Emuna, The Garden of Emuna, Garden of Peace, In Forest Fields, Chut Shel Chessed, emuna, faith, Breslev, Breslov, Rebbe Nachman, hisbodedus, personal prayer, Jewish faith, Arush books, ספרי הרב שלום ארוש, גן האמונה, בגן האמונה, אמונה" />
<meta name="author" content="Rabbi Shalom Arush" />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:site_name" content="Rabbi Shalom Arush — English Hub" />
<meta property="og:image" content={new URL("/img/arush-2.jpg", Astro.site)} />
<meta property="og:locale" content="en_US" />
<meta property="og:locale:alternate" content="he_IL" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={new URL("/img/arush-2.jpg", Astro.site)} />
<link rel="icon" href="/img/favicon-32.png" sizes="32x32" />
<link rel="icon" href="/img/icon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Assistant:wght@400;600;700&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context":"https://schema.org","@type":"Person","name":"Rabbi Shalom Arush",
  "alternateName":["Rav Shalom Arush","HaRav Shalom Arush","שלום ארוש","הרב שלום ארוש"],
  "jobTitle":"Rosh Yeshiva, Chut Shel Chessed","description":desc,
  "affiliation":{"@type":"Organization","name":"Chut Shel Chessed"},
  "knowsAbout":["Emuna","Faith","Breslev","Rebbe Nachman of Breslov","Personal prayer","Jewish spirituality"],
  "sameAs":[...Object.values(IDENTITY.socials),"https://en.wikipedia.org/wiki/Shalom_Arush","https://breslev.com"]
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context":"https://schema.org","@type":"WebSite","name":"Rabbi Shalom Arush — English Hub",
  "url":"https://ravarush.com/","inLanguage":["en","he"],
  "potentialAction":{"@type":"SearchAction","target":"https://ravarush.com/shiurim?q={q}","query-input":"required name=q"}
})} />
<script async src="https://www.googletagmanager.com/gtag/js?id=G-LM479Y2LEC"></script>
<script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-LM479Y2LEC')`} />
</head>
<body>
<header class="hdr"><div class="wrap in">
  <a class="brand" href="/"><img class="mk" src={mark} alt="" /><span><strong>Rabbi Shalom</strong> Arush</span></a>
  <nav class="nav">
    <a href="/shiurim">Shiurim</a>
    <a href="/sparks">✦ Sparks</a>
    <a href="/writings">Writings</a>
    <a href="/writings-he">עברית</a>
    <a href="/books">Books</a>
    <a href="/about">About</a>
  </nav>
</div></header>

<main class={wide ? "" : ""}><slot /></main>

<footer class="ftr"><div class="wrap">
  <div class="cols">
    <div style="max-width:320px">
      <div class="brand" style="margin-bottom:10px"><img class="mk" src={mark} alt="" /><span>Rabbi Shalom Arush</span></div>
      <p class="muted" style="font-size:.9rem">An English hub built by his students to spread the light of emuna, joy, and personal prayer.</p>
    </div>
    <div>
      <div class="eyebrow" style="margin-bottom:12px">Explore</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <a href="/shiurim">Shiurim — watch & listen</a>
        <a href="/writings">Writings</a>
        <a href="/books">His sefarim</a>
        <a href="/about">About the Rav</a>
      </div>
    </div>
    <div>
      <div class="eyebrow" style="margin-bottom:12px">Follow</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        {Object.entries(IDENTITY.socials).map(([k,v])=>(<a href={v} rel="noopener">{k}</a>))}
      </div>
    </div>
  </div>
  <p class="note">An unofficial English hub honoring the teachings of HaRav Shalom Arush shlit”a and Chut Shel Chessed, with links back to the official sources. All teachings © their authors and institutions.</p>
</div></footer>

<script>
  const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll(".rv").forEach(el=>io.observe(el));
  addEventListener("scroll",()=>document.querySelector(".hdr")?.classList.toggle("scrolled",scrollY>10));
</script>
</body>
</html>
