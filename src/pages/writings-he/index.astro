---
import Base from "../../layouts/Base.astro";
import { readFileSync } from "node:fs";
import { join } from "node:path";
const w = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "writings-he.json"), "utf8"));
---
<Base title="Hebrew Writings — כתבים בעברית" description="The Hebrew writings of Rabbi Shalom Arush — over 1,400 articles in his own words, sorted by theme, each with an option to translate to English.">
  <section class="section"><div class="wrap">
    <div class="section-head rv">
      <p class="eyebrow">כתבים בעברית · Hebrew Writings</p>
      <h2>{w.total} writings, <span class="au">in his own words</span>.</h2>
      <p>His Torah as he wrote it, in Hebrew — sorted into halls, and every article opens with one tap to translate into English.</p>
      <p style="margin-top:14px"><a href="/writings" style="color:var(--gold)">Prefer English? Enter the English writings →</a></p>
    </div>
    <input class="search" id="q" placeholder="חיפוש בכל הכתבים…" autocomplete="off" dir="rtl" />
    <div class="halls" id="halls">
      {w.halls.map((h)=>(
        <a class="hall rv" href={`/writings-he/${h.slug}`}>
          <div class="n">{h.count} מאמרים</div>
          <h3>{h.title}</h3>
          <p>{h.blurb}</p>
        </a>
      ))}
    </div>
    <div id="results" class="rows" style="margin-top:20px"></div>
  </div></section>
  <script type="application/json" id="idx" set:html={JSON.stringify(
    w.halls.flatMap(h=>h.articles.map(a=>({i:a.id,t:a.title,r:a.room})))
  )} />
  <script is:inline>
    const idx=JSON.parse(document.getElementById("idx").textContent);
    const q=document.getElementById("q"),halls=document.getElementById("halls"),res=document.getElementById("results");
    q.addEventListener("input",()=>{const v=q.value.trim();
      if(v.length<2){halls.style.display="";res.innerHTML="";return}
      halls.style.display="none";
      const hits=idx.filter(a=>a.t.includes(v)).slice(0,80);
      res.innerHTML=hits.map(a=>`<a class="row" href="/read-he/${a.i}" dir="rtl"><span class="t">${a.t}</span><span class="m">${a.r||""}</span></a>`).join("")||`<p class="muted" style="text-align:center;padding:20px">לא נמצא</p>`;
    });
  </script>
</Base>
