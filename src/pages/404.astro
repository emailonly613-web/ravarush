---
import Base from "../layouts/Base.astro";
---
<Base title="Not found" description="This page could not be found." noindex={true}>
  <section class="section"><div class="wrap" style="text-align:center;padding-block:14vh">
    <p class="eyebrow rv">Rav Arush</p>
    <h1 style="font-size:clamp(2.4rem,6vw,4rem)" class="rv">This path leads <span class="au">nowhere yet</span>.</h1>
    <p class="muted rv" style="max-width:520px;margin:16px auto 30px">The page you were looking for isn’t here — but the whole castle is one step away.</p>
    <div class="cta rv" style="justify-content:center">
      <a class="btn btn-gold" href="/">Return home</a>
      <a class="btn btn-ghost" href="/writings">Enter the writings</a>
    </div>
  </div></section>
</Base>
