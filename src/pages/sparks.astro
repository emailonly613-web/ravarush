---
import Base from "../layouts/Base.astro";
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
const P = join(process.cwd(), "public", "data", "sparks.json");
const sparks = existsSync(P) ? JSON.parse(readFileSync(P, "utf8")) : [];
const CDN = "https://ravarush-media.nyc3.cdn.digitaloceanspaces.com";
---
<Base title="Sparks" description="Sparks — short teachings of Rabbi Shalom Arush under four minutes. Shuffle through them like a feed.">
  <section class="section"><div class="wrap" style="text-align:center">
    <p class="eyebrow rv">✦ Sparks</p>
    <h2 class="rv">Short sparks of his <span class="au">Torah</span>.</h2>
    <p class="muted rv" style="max-width:560px;margin:12px auto 0">{sparks.length} shiurim under four minutes — shuffle through them, one after another.</p>
    <button id="startSparks" class="btn btn-gold rv" style="margin-top:26px">▸ Start shuffling</button>
  </div></section>

  <div id="sparkTheater" hidden>
    <button id="spkClose" aria-label="Close">✕</button>
    <div id="spkStage"><video id="spkVideo" playsinline></video></div>
    <div id="spkInfo"><b id="spkTitle"></b><small id="spkPos"></small></div>
    <button class="spk-nav spk-prev" id="spkPrev" aria-label="Previous">‹</button>
    <button class="spk-nav spk-next" id="spkNext" aria-label="Next">›</button>
    <div id="spkHint">tap / swipe / arrows for the next spark</div>
  </div>

  <script type="application/json" id="spkData" set:html={JSON.stringify(sparks)} />
  <script is:inline define:vars={{ CDN }}>
    const data = JSON.parse(document.getElementById("spkData").textContent);
    // shuffle
    for (let i = data.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [data[i], data[j]] = [data[j], data[i]]; }
    const th = document.getElementById("sparkTheater"), vid = document.getElementById("spkVideo");
    const title = document.getElementById("spkTitle"), pos = document.getElementById("spkPos");
    let qi = 0;
    function show(i) {
      qi = (i + data.length) % data.length; const s = data[qi];
      vid.src = `${CDN}/video/${s.id}.mp4`; vid.muted = false; vid.play().catch(() => { vid.muted = true; vid.play().catch(()=>{}); });
      title.textContent = s.title; pos.textContent = `${qi + 1} / ${data.length}`;
    }
    const next = () => show(qi + 1), prev = () => show(qi - 1);
    function open() { if (!data.length) return; th.hidden = false; document.body.style.overflow = "hidden"; show(0); }
    function close() { th.hidden = true; vid.pause(); vid.src = ""; document.body.style.overflow = ""; }
    document.getElementById("startSparks").addEventListener("click", open);
    document.getElementById("spkClose").addEventListener("click", close);
    document.getElementById("spkNext").addEventListener("click", next);
    document.getElementById("spkPrev").addEventListener("click", prev);
    vid.addEventListener("ended", next);
    vid.addEventListener("click", () => (vid.paused ? vid.play() : vid.pause()));
    addEventListener("keydown", (e) => { if (th.hidden) return; if (e.key === "ArrowRight" || e.key === "ArrowDown") next(); if (e.key === "ArrowLeft" || e.key === "ArrowUp") prev(); if (e.key === "Escape") close(); });
    let sy = 0; th.addEventListener("touchstart", (e) => (sy = e.touches[0].clientY), { passive: true });
    th.addEventListener("touchend", (e) => { const dy = e.changedTouches[0].clientY - sy; if (Math.abs(dy) > 45) (dy < 0 ? next() : prev()); });
    if (location.hash === "#play") open();
  </script>

  <style>
    #sparkTheater{position:fixed;inset:0;z-index:200;background:#000;display:flex;align-items:center;justify-content:center}
    #spkStage{width:min(100%,520px);height:100%;display:flex;align-items:center;justify-content:center}
    #spkVideo{width:100%;max-height:100vh;background:#000;border-radius:0}
    #spkClose{position:absolute;top:16px;right:18px;z-index:3;background:rgba(0,0,0,.5);color:#fff;border:none;font-size:1.4rem;width:44px;height:44px;border-radius:50%;cursor:pointer}
    #spkInfo{position:absolute;left:0;right:0;bottom:24px;text-align:center;color:#fff;padding:0 60px;z-index:2;pointer-events:none;text-shadow:0 2px 10px rgba(0,0,0,.8)}
    #spkInfo b{display:block;font-family:var(--serif);font-size:1.25rem}#spkInfo small{color:var(--gold)}
    .spk-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.4);color:#fff;border:none;font-size:2rem;width:52px;height:52px;border-radius:50%;cursor:pointer;z-index:2}
    .spk-prev{left:14px}.spk-next{right:14px}
    #spkHint{position:absolute;top:18px;left:0;right:0;text-align:center;color:rgba(255,255,255,.6);font-size:.85rem;z-index:2;pointer-events:none}
    @media(min-width:760px){#spkVideo{border-radius:16px}}
  </style>
</Base>
