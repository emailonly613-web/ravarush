---
import Base from "../../layouts/Base.astro";
import { readFileSync } from "node:fs";
import { join } from "node:path";
const WPATH = join(process.cwd(), "public", "data", "writings.json");
const w = JSON.parse(readFileSync(WPATH, "utf8"));
export function getStaticPaths() {
  const wr = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "writings.json"), "utf8"));
  return wr.halls.map((h) => ({ params: { hall: h.slug } }));
}
const { hall } = Astro.params;
const H = w.halls.find((h) => h.slug === hall);
if (!H) return Astro.redirect("/writings");
---
<Base title={H.title} description={H.blurb} dawn={true}>
  <div class="dawn dawn--page">
  <section class="section"><div class="wrap">
    <p class="crumbs"><a href="/writings">Writings</a> › {H.title}</p>
    <div class="section-head rv" style="text-align:left;margin-left:0">
      <p class="eyebrow">{H.count} writings</p>
      <h2>{H.title}</h2>
      <p>{H.blurb}</p>
    </div>
    <input class="search" id="q" placeholder={`Search within ${H.title}…`} autocomplete="off" style="margin-left:0" />
    <div class="rows" id="rows">
      {H.articles.map((a)=>(
        <a class="row rv" href={`/read/${a.id}`} data-t={a.title.toLowerCase()}>
          <span class="t">{a.title}</span>
          <span class="m">{a.room}{a.date ? ` · ${a.date}` : ""}</span>
        </a>
      ))}
    </div>
  </div></section>
  <script is:inline>
    const q=document.getElementById("q"), rows=[...document.querySelectorAll("#rows .row")];
    q.addEventListener("input",()=>{const v=q.value.trim().toLowerCase();
      rows.forEach(r=>r.style.display=(!v||r.dataset.t.includes(v))?"":"none")});
  </script>
  </div>
</Base>
