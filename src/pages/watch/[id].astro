---
import Base from "../../layouts/Base.astro";
import { readFileSync, readdirSync, existsSync } from "node:fs";
import { join } from "node:path";
const WDIR = join(process.cwd(), "public", "data", "watch");
export function getStaticPaths() {
  const dir = join(process.cwd(), "public", "data", "watch");
  if (!existsSync(dir)) return [];
  return readdirSync(dir).filter((f) => f.endsWith(".json")).map((f) => ({ params: { id: f.replace(".json", "") } }));
}
const { id } = Astro.params;
const v = JSON.parse(readFileSync(join(WDIR, `${id}.json`), "utf8"));
// media-manifest.json is written by the upload pipeline (id → {v,a}) as each file lands on the CDN.
const MPATH = join(process.cwd(), "public", "data", "media-manifest.json");
const manifest = existsSync(MPATH) ? JSON.parse(readFileSync(MPATH, "utf8")) : {};
const media = manifest[id] || {};
const CDN = "https://ravarush-media.nyc3.cdn.digitaloceanspaces.com";
const hasVideo = !!media.v, hasAudio = !!media.a, archived = hasVideo || hasAudio;
---
<Base title={v.title} description={`${v.title} — a shiur from Rabbi Shalom Arush.`}>
  <article class="reader"><div class="wrap">
    <p class="crumbs"><a href="/shiurim">Shiurim</a>{v.series?.[0] ? ` › ${v.series[0]}` : ""}</p>
    <p class="kicker">Rabbi Shalom Arush · Shiur</p>
    <h1 dir={v.lang === "he" ? "rtl" : "ltr"}>{v.title}</h1>
    <p class="by">{v.date}</p>

    {hasVideo && (
      <video controls preload="metadata" style="width:100%;border-radius:14px;background:#000;margin-bottom:16px" src={`${CDN}/video/${id}.mp4`}></video>
    )}
    {!hasVideo && hasAudio && (
      <audio controls preload="metadata" style="width:100%;margin-bottom:16px" src={`${CDN}/audio/${id}.mp3`}></audio>
    )}

    <div class="transbar" style="flex-direction:column;align-items:stretch;gap:14px">
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between">
        <span class="lbl">Watch, listen &amp; download</span>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          {hasVideo && <a class="chip" href={`${CDN}/video/${id}.mp4`}>⬇ Video (MP4)</a>}
          {hasAudio && <a class="chip" href={`${CDN}/audio/${id}.mp3`}>⬇ Audio (MP3)</a>}
          <a class="chip" href={v.source} rel="noopener" target="_blank">▶ Watch on Breslev</a>
          {!archived && <span class="chip" style="opacity:.6">⬇ Download — being prepared</span>}
        </div>
      </div>
      <p class="muted" style="font-size:.85rem;margin:0">
        {archived ? "Play it here, or download the video or audio to keep." : "Every shiur is being archived in video and audio to watch, stream, and download. This one opens here as soon as it finishes."}
      </p>
    </div>

    <p class="muted" style="text-align:center;margin-top:26px">
      From the shiurim of HaRav Shalom Arush · <a href="/shiurim" style="color:var(--gold)">back to the shiurim</a>
    </p>
  </div></article>
</Base>
